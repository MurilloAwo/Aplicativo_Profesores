# =============================================================================
# Aplicativo de actividades docentes — Depto. Informática y Computación (UNAL)
# Plantilla de configuración. Copiar a .env y completar:  cp .env.example .env
# Luego:  php artisan key:generate
# NUNCA versionar el archivo .env.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
APP_NAME="Actividades Docentes"
# local | production
APP_ENV=production
# Se genera con: php artisan key:generate
APP_KEY=
# OBLIGATORIO false en el servidor (mitiga aviso PKSA-d5tc-s1qs-h781)
APP_DEBUG=false
# URL pública (el dominio debe apuntar a la carpeta public/)
APP_URL=https://actividades.example.unal.edu.co
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Bogota

# --- Logs --------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
# debug en local, warning o error en producción
LOG_LEVEL=warning

# --- Base de datos (MySQL / MariaDB, utf8mb4) --------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=actividades_docentes
DB_USERNAME=usuario_app
DB_PASSWORD=

# --- Drivers -----------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Evidencias en disco "local" privado (storage/app). No usar "public".
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# true cuando se sirva por HTTPS
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo (recuperación de contraseña) — datos institucionales pendientes --
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-responder@example.unal.edu.co"
MAIL_FROM_NAME="${APP_NAME}"

# --- No utilizados por ahora (se conservan por compatibilidad con Laravel) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
